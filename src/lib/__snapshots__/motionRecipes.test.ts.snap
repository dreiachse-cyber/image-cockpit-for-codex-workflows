exports[`versioned Motion Recipes > snapshots Experimental compiler contract for charge-heavy-attack 1`] = `
{
  "experimental": true,
  "id": "charge-heavy-attack",
  "metadata": {
    "bodyTopology": "biped",
    "compilerVersion": "1.2.0",
    "experimental": true,
    "frameCount": 12,
    "id": "charge-heavy-attack",
    "modifiers": {
      "exaggeration": "normal",
      "handedness": "right",
      "intensity": "strong",
      "secondaryMotionLevel": "normal",
      "tempo": "slow",
      "travelAmount": "in-place",
      "vfxAmount": "low",
      "weaponClass": "heavy-weapon",
      "weight": "heavy",
    },
    "qualityProfile": "grounded-soft",
    "version": 1,
  },
  "prompt": "HARD: Motion Recipe: charge-heavy-attack v1; compiler 1.2.0. Create exactly 12 source frames for each requested direction. Use fixed 256px by 256px cells and keep every frame isolated inside its own cell.
MOTION: Heavy charged attack with visible weight loading, delayed release, one decisive impact, broad follow-through, and controlled recovery. The support contacts and prop grip must remain coherent while the attack arc becomes wider than a basic attack. hair and clothing follow-through must lag the body motion without replacing the primary action Variant intensity is strong: widen the primary action silhouette and preserve controlled recovery. Variant tempo is slow: extend anticipation and settling beats without duplicating frames. Variant weight is heavy: use deeper loading, broader committed motion, delayed follow-through, and stronger support contact. Keep right-handed grip and weapon-side identity consistent in every direction and frame. Preserve one consistent heavy-weapon design, grip, scale, and attachment through all phases. Use low VFX drawn only from the Recipe allowlist and keep body, prop, and contact silhouette visible.
PHASES: Frames 1-1: ready. Frames 2-3: load weight. Frames 4-4: deep charge. Frames 5-6: release begins. Frames 7-7: heavy impact. Frames 8-9: follow-through. Frames 10-10: recover weight. Frames 11-12: ready end.
IDENTITY: Preserve the uploaded character's identity, outfit, palette, head-to-body ratio, silhouette, props, and pixel density in every frame. Keep one real character scale across every direction and pose; lower poses become shorter and must never be enlarged to fill the cell. Keep the complete hair, head, hands, props, effects, outfit, and feet inside every 256px cell with readable padding. Keep the root centered; do not translate, skate, or auto-center each frame independently. Keep at least one planted foot or the robe hem on a stable visual baseline; preserve bottom-center export anchor. Body topology: biped. Keep the full head-to-feet silhouette inside the cell with stable head size and leg length. Use the bottom-center root between the planted feet and preserve the standing baseline. Measure root translation from the pelvis and the midpoint between planted feet. Keep both legs readable in front and rear views. Keep the profile foot order and weapon side readable in side view.
DIRECTION: Make the same motion readable from every requested view and preserve strict direction identity. Requested directions only: front, side, back. Direction identity: front is straight toward camera, side is strict profile, back is a true straight rear view with no face details.
BACKGROUND: Prefer transparent background; otherwise use only the requested flat chroma-key color.
NEGATIVE: cropped hair, cropped head, cropped feet, duplicated heads, body fragments, changed character identity nonuniform character scale, per-cell auto-fit, neighboring-cell intrusion, camera drift non-flat background, gradients, shadows baked into the chroma key, text, labels, UI symbols light jab, rapid combo, continuous loop, detached weapon, grip switching",
  "promptDiff": [
    "Topology: Biped",
    "Frame budget: 12",
    "Variant intensity is strong: widen the primary action silhouette and preserve controlled recovery.",
    "Variant tempo is slow: extend anticipation and settling beats without duplicating frames.",
    "Variant weight is heavy: use deeper loading, broader committed motion, delayed follow-through, and stronger support contact.",
    "Keep right-handed grip and weapon-side identity consistent in every direction and frame.",
    "Preserve one consistent heavy-weapon design, grip, scale, and attachment through all phases.",
    "Use low VFX drawn only from the Recipe allowlist and keep body, prop, and contact silhouette visible.",
  ],
  "qa": {
    "actionProfile": "grounded-soft",
    "allowedVfx": [
      "compact heavy slash arc",
      "small impact burst",
      "brief charge glow",
    ],
    "anchorPolicy": "Use the bottom-center root between the planted feet and preserve the standing baseline.",
    "bboxExpectation": "Keep the full head-to-feet silhouette inside the cell with stable head size and leg length.",
    "bodyTopology": "biped",
    "contactQaDimension": "footline",
    "expectedPhases": [
      "ready",
      "load weight",
      "deep charge",
      "release begins",
      "heavy impact",
      "follow-through",
      "recover weight",
      "ready end",
    ],
    "exportDefaults": {
      "anchor": {
        "x": 0.5,
        "y": 0.9,
      },
      "background": "transparent",
      "cell": {
        "height": 256,
        "width": 256,
      },
      "playback": "normal",
    },
    "footlineApplicable": true,
    "footlineTolerancePx": 8,
    "fps": 8,
    "frameCount": 12,
    "frameGrid": {
      "columns": 4,
      "gutter": 0,
      "rows": 3,
    },
    "groundContactParts": [
      "left foot",
      "right foot",
      "robe hem when it replaces visible feet",
    ],
    "groundingProfile": "grounded",
    "loopExpected": false,
    "loopMode": "one-shot",
    "modifiers": {
      "exaggeration": "normal",
      "handedness": "right",
      "intensity": "strong",
      "secondaryMotionLevel": "normal",
      "tempo": "slow",
      "travelAmount": "in-place",
      "vfxAmount": "low",
      "weaponClass": "heavy-weapon",
      "weight": "heavy",
    },
    "motionRange": [
      0.004,
      0.4602,
    ],
    "recipe": {
      "bodyTopology": "biped",
      "compilerVersion": "1.2.0",
      "experimental": true,
      "frameCount": 12,
      "id": "charge-heavy-attack",
      "modifiers": {
        "exaggeration": "normal",
        "handedness": "right",
        "intensity": "strong",
        "secondaryMotionLevel": "normal",
        "tempo": "slow",
        "travelAmount": "in-place",
        "vfxAmount": "low",
        "weaponClass": "heavy-weapon",
        "weight": "heavy",
      },
      "qualityProfile": "grounded-soft",
      "version": 1,
    },
    "requiredProps": [
      "preserve the source weapon or focus when present",
      "preserve heavy-weapon identity, grip, and attachment",
    ],
    "rootDriftTolerancePx": 10,
    "rootMotionPolicy": "Measure root translation from the pelvis and the midpoint between planted feet.",
    "secondaryMotion": [
      "hair",
      "clothing",
      "tail or carried gear when present",
    ],
  },
  "summary": "Biped, 12 frames, intensity=strong, tempo=slow, weight=heavy, handedness=right, weaponClass=heavy-weapon, vfxAmount=low.",
}
`;

